# Copie este archivo como .env y ajuste los valores.
CI_ENVIRONMENT=development

app.baseURL=http://localhost:8080/
app.indexPage=
app.forceGlobalSecureRequests=false

cors.allowedOrigins=http://localhost:3000
cors.allowedHeaders=Authorization,Content-Type,Accept,Origin
cors.allowedMethods=GET,POST,PUT,DELETE,OPTIONS

JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_TTL=3600

database.default.hostname=127.0.0.1
database.default.database=SistemaPermisos
database.default.username=permisos
database.default.password=cambiar_en_produccion
database.default.DBDriver=MySQLi
database.default.port=3306
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_unicode_ci

uploads.maxMB=10
uploads.path=uploads/
